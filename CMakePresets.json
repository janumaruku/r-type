{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "linux",
            "hidden": true,
            "inherits": "base",
            "generator": "Unix Makefiles",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "windows",
            "hidden": true,
            "inherits": "base",
            "architecture": "x64",
            "toolset": "ClangCL",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "inherits": "linux",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "inherits": "linux",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "RTYPE_BUILD_TESTS": "OFF" }
        },
        {
            "name": "linux-coverage",
            "displayName": "Linux Coverage (Clang)",
            "inherits": "linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "clang++",
                "WITH_COVERAGE": "ON"
            }
        },
        {
            "name": "windows-clangcl-debug",
            "displayName": "Windows clang-cl Debug",
            "inherits": "windows"
        },
        {
            "name": "windows-clangcl-release",
            "displayName": "Windows clang-cl Release",
            "inherits": "windows",
            "cacheVariables": { "RTYPE_BUILD_TESTS": "OFF" }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-debug",
            "jobs": 0,
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "jobs": 0,
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-coverage",
            "configurePreset": "linux-coverage",
            "jobs": 0,
            "targets": ["coverage"]
        },
        {
            "name": "windows-clangcl-debug",
            "configurePreset": "windows-clangcl-debug",
            "configuration": "Debug"
        },
        {
            "name": "windows-clangcl-release",
            "configurePreset": "windows-clangcl-release",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-clangcl-debug",
            "configurePreset": "windows-clangcl-debug",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
