include(GoogleTest)

set(RTYPE_TEST_ENVIRONMENT "")
if (RTYPE_SANITIZER STREQUAL "address")
    set(RTYPE_TEST_ENVIRONMENT "LSAN_OPTIONS=suppressions=${PROJECT_SOURCE_DIR}/cmake/sanitizers/lsan.supp")
endif ()

function(rtype_add_test name)
    cmake_parse_arguments(ARG "" "" "SOURCES;LIBS" ${ARGN})
    add_executable(${name} ${ARG_SOURCES})
    target_link_libraries(${name} PRIVATE ${ARG_LIBS} GTest::gtest_main project_options)
    if (RTYPE_TEST_ENVIRONMENT)
        gtest_discover_tests(${name} PROPERTIES ENVIRONMENT "${RTYPE_TEST_ENVIRONMENT}")
    else ()
        gtest_discover_tests(${name})
    endif ()
    set_property(GLOBAL APPEND PROPERTY RTYPE_TEST_TARGETS ${name})
endfunction()
